cat > .gitignore << 'EOF'
# ─── Python ───
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/

# ─── Virtual environment ───
venv/
.venv/
env/

# ─── Environment ───
.env
.env.local
.env.*.local

# ─── Voice profile (personal) ───
voice_profile.npy
*.npy

# ─── Local database ───
remy.db
*.db

# ─── Piper voice models (too big) ───
*.onnx
*.onnx.json

# ─── Temp audio ───
temp.flac
temp_speech_*.wav
temp_*.wav

# ─── Backups ───
*.bak
*.save
*.old

# ─── Test files ───
test_*.py
*_test.py

# ─── macOS ───
.DS_Store
.AppleDouble
.LSOverride

# ─── IDE ───
.vscode/
.idea/
*.swp
*.swo

# ─── Logs ───
*.log
EOF