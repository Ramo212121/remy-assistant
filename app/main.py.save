import flet as ft


def main(page: ft.Page):
    page.title = "Remy"
    page.theme_mode = ft.ThemeMode.DARK
    page.window_width = 420
    page.window_height = 800
    page.padding = 0
    page.bgcolor = "#0F172A"

    # Header
    header = ft.Container(
        content=ft.Row([
            ft.Text("🤖 Remy", size=24, weight=ft.FontWeight.BOLD, color="#F1F5F9"),
            ft.Row([
                ft.IconButton(ft.Icons.SETTINGS, icon_color="#94A3B8"),
                ft.IconButton(ft.Icons.DARK_MODE, icon_color="#94A3B8"),
            ])
        ], alignment=ft.MainAxisAlignment.SPACE_BETWEEN),
        padding=ft.padding.all(20),
        bgcolor="#1E293B",
        border_radius=ft.border_radius.only(bottom_left=20, bottom_right=20),
    )

    # Chat area
    chat = ft.ListView(
        expand=True,
        spacing=10,
        padding=20,
        auto_scroll=True,
    )

    # Message bubble
    def message_bubble(text, is_user=False):
        return ft.Container(
            content=ft.Text(text, color="#F1F5F9", size=15),
            bgcolor="#6366F1" if is_user else "#1E293B",
            padding=ft.padding.symmetric(horizontal=16, vertical=12),
            border_radius=ft.border_radius.only(
                top_left=16, top_right=16,
                bottom_left=16 if is_user else 4,
                bottom_right=4 if is_user else 16,
            ),
            alignment=ft.alignment.center_right if is_user else ft.alignment.center_left,
        )

    # Input
    input_field = ft.TextField(
        hint_text="Type a message...",
        expand=True,
        border_radius=24,
        filled=True,
        bgcolor="#1E293B",
        border_color="transparent",
        color="#F1F5F9",
        hint_style=ft.TextStyle(color="#94A3B8"),
    )

    def send_message(e):
        if not input_field.value:
            return
        chat.controls.append(message_bubble(input_field.value, is_user=True))
        input_field.value = ""
        page.update()

    send_btn = ft.IconButton(
        icon=ft.Icons.SEND,
        on_click=send_message,
        icon_color="#6366F1",
    )

    mic_btn = ft.IconButton(
        icon=ft.Icons.MIC,
        icon_color="#EF4444",
    )

    input_row = ft.Container(
        content=ft.Row([mic_btn, input_field, send_btn]),
        padding=ft.padding.all(15),
        bgcolor="#1E293B",
        border_radius=ft.border_radius.only(top_left=20, top_right=20),
    )

    page.add(header, chat, input_row)


ft.app(target=main)

